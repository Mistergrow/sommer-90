{
	"schema": "software.v1",
	"description": "Feld-Definition der Software-Bibel. Dokumentation, wird vom Motor nicht als Content geladen (führendes '_').",
	"required": ["software_id", "historical_name", "category"],
	"policy": "Nie historische Daten raten. Unsichere Angaben leer lassen und 'needs_verification': true setzen. Genauigkeit vor Vollständigkeit.",
	"fields": {
		"software_id": "String, eindeutig, unveränderlich, z.B. 'deluxe_paint_iv'. Einzige Referenz für alle Systeme.",
		"historical_name": "String, exakter historischer Originalname. Muss eindeutig sein.",
		"display_name": "String, im Spiel angezeigter Name (darf Homage/Parodie sein).",
		"alternative_names": "Array<String>, Alias-/Regionalnamen.",
		"category": "String, Hauptkategorie (games, workbench, disk_utilities, ...).",
		"subcategory": "String, feinere Einordnung.",
		"genre": "String, z.B. 'Jump n Run', 'Tracker', 'Paint'.",
		"platform": "String, z.B. 'Amiga', 'Amiga AGA', 'PC DOS', 'C64'.",
		"developer": "String, developer_id (Developer-Bibel) oder Name.",
		"publisher": "String, publisher_id (Publisher-Bibel) oder Name.",
		"country": "String, Herkunftsland (ISO oder Klartext).",
		"release_date": "String, ISO-Datum falls bekannt (YYYY-MM-DD), sonst leer.",
		"release_year": "Int, Erscheinungsjahr.",
		"last_supported_year": "Int, letztes relevantes Jahr.",
		"language": "String/Array, Sprache(n).",
		"disk_count": "Int, Anzahl Disketten.",
		"media_type": "String, 'floppy_880', 'floppy_720', 'cd', 'hd_install'.",
		"installation_required": "Bool.",
		"manual": "Bool, Handbuch vorhanden.",
		"manual_pages": "Int.",
		"copy_protection": "String, Art (nur beschreibend, NIE Umgehung).",
		"original_box": "Bool.",
		"box_contents": "Array<String>.",
		"required_memory": "Int, Mindest-RAM in KB (manche liefen nicht auf jedem Amiga).",
		"required_cpu": "String, z.B. '68000', '68020'.",
		"required_hardware": "Array<String>, hardware_ids.",
		"required_programs": "Array<String>, software_ids (Abhängigkeiten).",
		"shop_available": "Bool, grundsätzlich im Computerladen erhältlich.",
		"bbs_available": "Bool.",
		"friend_available": "Bool.",
		"computer_club_available": "Bool.",
		"coverdisk_available": "Bool.",
		"magazine_available": "Bool.",
		"mail_order_available": "Bool.",
		"flea_market_available": "Bool.",
		"rarity": "String/Int, Seltenheit (common..legendary oder 0-100).",
		"collector_value": "Int, Sammlerwert (Basis).",
		"condition_modifier": "Float, Zustandsfaktor.",
		"scene_popularity": "Int 0-100, Bekanntheit in der Szene.",
		"mainstream_popularity": "Int 0-100.",
		"historical_importance": "Int 0-100.",
		"educational_value": "Int 0-100.",
		"review_score": "Float, historische Wertung.",
		"review_count": "Int.",
		"keywords": "Array<String>, für Suche.",
		"tags": "Array<String>.",
		"notes": "String, freie historische Notizen/Quellen-Hinweise.",
		"needs_verification": "Bool, true wenn Daten noch zu prüfen sind.",
		"sources": "Array<String>, Quellenangaben für historische Genauigkeit."
	},
	"timeline": {
		"description": "Optionale Jahres-Scheiben 1990-2000. Nur Jahre eintragen, in denen sich etwas ändert.",
		"per_year_fields": {
			"available": "Bool", "shop": "Bool", "bbs": "Bool", "friend": "Bool",
			"magazine": "Bool", "coverdisk": "Bool", "price": "Int (DM)",
			"used_price": "Int (DM)", "collector_value": "Int",
			"trend": "String (rising/stable/falling)", "hype": "Int 0-100", "retro": "Bool"
		}
	},
	"requirements": {
		"description": "Freischalt-Bedingungen. Alle optional.",
		"fields": {
			"modem": "Bool", "printer": "Bool", "cdrom": "Bool",
			"ram_expansion": "Int (KB)", "workbench_version": "String",
			"friendship": "Int (Vertrauen)", "computer_club": "Bool",
			"magazine": "String (magazine_id)", "bbs_account": "Bool",
			"mail_order": "Bool", "quest": "String (quest_id)",
			"shop_order": "Bool", "year": "Int"
		}
	}
}
