[node name="BlackMarketDealer" type="TextureRect" parent="." unique_id=954295557]
editor_description = "SPIELAKTOR: Diesen Knoten im 2D-Editor verschieben (W) und über Transform > Scale skalieren. DealerInteractionArea ist ein Kind und folgt jeder Transformation.

ACHTUNG BODENKONTAKT: Das Sprite hat 13,5 % leeren Rand unten — die Füße sitzen NICHT an der Rechteckunterkante. Der Pivot ist deshalb auf die gemessene Standfläche gesetzt (74,5 / 186,8 statt mittig-unten). Erst dadurch bleibt der Bodenkontakt beim Skalieren stehen. Beim Ändern der Rechteckgröße den Pivot mitziehen: x = 0,611 · Breite, y = 0,865 · Höhe.

MASSSTAB: Sichtbar sind nur 80,6 % der Rechteckhöhe. Das aktuelle Rechteck 122 × 216 ergibt eine 174 px hohe Figur mit Fußlinie bei y = 322 (nicht 351)."
layout_mode = 0
offset_left = 687.0
offset_top = 135.0
offset_right = 809.0
offset_bottom = 351.0
pivot_offset = Vector2(74.5, 186.8)
tooltip_text = "Händler: frei verschieben und über Transform > Scale skalieren. Pivot sitzt auf der Standfläche, die Klickzone folgt automatisch."
texture = ExtResource("2_dealer")
expand_mode = 1
stretch_mode = 5

