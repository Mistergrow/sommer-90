[display]

window/size/viewport_width=1440
window/size/viewport_height=810
window/size/mode=2
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/export_runtime_assets/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://locale/game.de.translation", "res://locale/game.en.translation")
locale/fallback="de"
locale/allow_fallback=false

[rendering]

textures/canvas_textures/default_texture_filter=0
