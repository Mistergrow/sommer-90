; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sommer '90"
config/description="Nostalgisches Managementspiel über die Heimcomputer-Ära 1990-1999 — eine spielbare Erinnerung."
config/version="0.1.0"
run/main_scene="res://scenes/Startup.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/icons/favicon.svg"
config/full_version_url="https://sommer90.vibechain.rocks/"

[autoload]

PlayerStats="*res://scripts/autoload/player_stats.gd"
